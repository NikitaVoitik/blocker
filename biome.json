{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!site",
      "!docs",
      "!store-screenshots",
      "!coverage/.instrumented",
      "!coverage/.raw",
      "!coverage/report",
      "!**/*.min.js",
      "!rules.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "off"
      }
    }
  },
  "javascript": {
    "globals": ["chrome"],
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "recommended": true,
      "complexity": {
        "noUselessStringConcat": "error",
        "useDateNow": "error",
        "noForEach": "off",
        "noImportantStyles": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useNumberNamespace": "error",
        "noYodaExpression": "error",
        "useDefaultParameterLast": "error",
        "useSingleVarDeclarator": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useShorthandAssign": "error",
        "noNonNullAssertion": "error",
        "useThrowOnlyError": "error",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**", "playwright*.config.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    }
  ]
}
